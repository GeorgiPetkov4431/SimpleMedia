@model IEnumerable<PostAllViewModel>
@{
	ViewData["Title"] = "All Posts";
    string? errorMessage = TempData["Error"]?.ToString();
	string? successMessage = TempData["Success"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<h1>All Posts</h1>

<div class="row">

	@foreach (PostAllViewModel p in Model)
	{
		<div class="card col-3 h-100" style="width: 20rem;" >

            <div class="card-body" style="height: calc(100% - 150px); overflow: auto;">
                <div class="row">
                    <div class="col-12">
                        <div class="title-wrapper" style="height: 6em; overflow: hidden;">
                            <p class="text-muted mb-1">@@@p.UserName</p>
                            <h4 class="card-title mt-1">@p.Title</h4>
                        </div>
                    </div>
                </div>

                <p>Created On: @p.CreatedOn</p>
            </div>

            <div class="row gx-0">
                <div class="col-12 px-1">
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@p.Id"
                       class="btn btn-warning btn-sm mb-2 w-100 fw-bold rounded btn-dark-text">View Post</a>
                </div>
            </div>
		</div>
	}
</div>