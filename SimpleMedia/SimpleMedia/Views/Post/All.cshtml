@model IEnumerable<PostAllViewModel>
@{
	ViewData["Title"] = "All Posts";
    string? errorMessage = TempData["Error"]?.ToString();
	string? successMessage = TempData["Success"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<h1>All Posts</h1>

<form asp-controller="Post" asp-action="All" method="get" class="mb-3 d-flex gap-2">
    <div class="input-group">
        <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" class="form-control" placeholder="Search posts..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-controller="Post" asp-action="All" class="btn btn-outline-secondary">Clear</a>
    </div>
    <a asp-controller="Post" asp-action="Create" class="btn btn-warning">Create</a>
</form>

<div class="row">

	@foreach (PostAllViewModel post in Model)
	{
		<partial name="_PostPartial" model="post" />
	}
</div>