@model PostDetailsViewModel
@{
	ViewData["Title"] = $"{Model.UserName}'s Post";
    bool canDeletePost = User?.Identity?.IsAuthenticated == true
        && string.Equals(User.Identity!.Name, Model.UserName);
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-footer d-flex gap-2">
                    <a asp-controller="Post" asp-action="All" class="btn btn-secondary">Back to All Posts</a>

                    @if (canDeletePost)
                    {
                        <div class="ms-auto d-flex gap-2">
                            <a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">Edit Post</a>
                            <a asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete Post</a>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted mb-1">Posted by: @@@Model.UserName</p>
                    <h2 class="card-title mb-3">@Model.Title</h2>
                    <p class="card-text" style="white-space: pre-wrap;">@Model.Content</p>
                    <p class="card-text" style="white-space: pre-wrap;">Tag: @Model.TagName</p>
                    <p class="text-muted mt-4 mb-0">Created on: @Model.CreatedOn</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-controller="Post"
                          asp-action="Like"
                          asp-route-id="@Model.Id"
                          method="post">
                        <button type="submit"
                                class="btn btn-secondary">
                            @(Model.LikedByCurrentUser ? "Unlike" : "Like")
                        </button>
                    </form>
                    <p class="text-muted mt-2 mb-0">Likes: @Model.LikesCount</p>
                </div>
            </div>

            <!-- Comments section -->
            <div class="mt-4">
                <h4 class="mb-3">Comments:</h4>

                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <div class="list-group mb-3">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="list-group-item">
                                <p class="mb-1"><strong>@@@comment.UserName</strong> <span class="text-muted">@comment.CreatedOn</span></p>
                                <p class="mb-0" style="white-space: pre-wrap;">@comment.Content</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No comments yet. Be the first to comment!</p>
                }

                <a asp-controller="Comment"
                   asp-action="Add"
                   asp-route-postId="@Model.Id"
                   class="btn btn-primary">Write Comment</a>
            </div>
        </div>
    </div>
</div>