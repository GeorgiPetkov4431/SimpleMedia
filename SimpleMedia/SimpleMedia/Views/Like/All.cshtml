@model IEnumerable<LikeAllViewModel>
@{
	ViewData["Title"] = "Liked Posts";
}

<div class="container mt-4">
	<h1>Liked Posts</h1>
	<div class="row">
		@if (Model.Count() == 0)
		{
			<p class="text-muted">You have no liked posts!</p>
		}
		@foreach (var post in Model)
		{
			<div class="col-12 col-md-6 col-lg-4 mb-4">
				<div class="card shadow-sm h-100">
					<div class="card-body d-flex flex-column">
						<p class="text-muted mb-1">@@@post.UserName</p>
						<h5 class="card-title">@post.Title</h5>
						<p class="card-text text-muted">Created on: @post.CreatedOn</p>
						<a asp-controller="Post" asp-action="Details" asp-route-id="@post.PostId" class="btn btn-warning mt-auto">View Post</a>
						<form asp-controller="Like" asp-action="Unlike" asp-route-id="@post.PostId" method="post" class="mt-2">
							<button type="submit" class="btn btn-secondary w-100">Unlike</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
</div>
